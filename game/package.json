{
  "name": "paint-battle",
  "version": "1.0.0",
  "description": "A real-time multiplayer paint battle game",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "db:sync": "node -e \"require('./server/config/database').syncDatabase({alter: true})\"",
    "db:reset": "node -e \"require('./server/config/database').syncDatabase({force: true})\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run lint && npm test"
  },
  "keywords": [
    "game",
    "multiplayer",
    "realtime",
    "strategy",
    "paint",
    "battle"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "sequelize": "^6.35.1",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "nodemonConfig": {
    "watch": ["server", "game"],
    "ext": "js,json",
    "ignore": ["node_modules", "coverage", "*.test.js"]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server/**/*.js",
      "!server/index.js",
      "!server/config/database.js"
    ],
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "indent": ["error", 4],
      "linebreak-style": ["error", "unix"],
      "quotes": ["error", "single"],
      "semi": ["error", "always"],
      "no-console": "warn",
      "no-unused-vars": "warn"
    }
  }
}
